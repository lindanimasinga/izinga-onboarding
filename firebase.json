{
  "hosting": [
    {
      "site": "onboarding-izinga",
      "public": "dist/izinga-signup",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8089
    },
    "ui": {
      "enabled": false
    }
  }
}
